# Expo public env — copy to apps/mobile/.env
# Catalog is still the in-repo mock (IDs match supabase/seed.sql).
# Checkout / entitlements / downloads call the Next.js web API.
# Google OAuth uses the same Supabase project (no extra EXPO_PUBLIC_GOOGLE_* vars).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Web app origin (no trailing slash). Required for Stripe Checkout on mobile.
# Local: http://localhost:3000  (use your LAN IP from a physical device)
# Hosted: https://YOUR_WEB_HOST
EXPO_PUBLIC_API_URL=
