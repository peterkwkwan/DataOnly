# Copy to apps/web/.env.local and fill from dashboards.
# Leave Supabase unset to run against the in-repo mock catalog.
# Never commit real secret values.

# --- Supabase (Alpha+) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: used by Stripe webhook entitlement writes + scripts/seed-remote.mjs
# (server-only — never NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe Connect (Beta purchase flow) ---
# Dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server-only secret key (sk_test_… / sk_live_…)
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → endpoint signing secret (whsec_…)
# Endpoint URL: https://YOUR_HOST/api/stripe/webhook
# Events: checkout.session.completed, account.updated
STRIPE_WEBHOOK_SECRET=
# Optional platform fee % of listing price (default 10)
# STRIPE_PLATFORM_FEE_PERCENT=10

# Optional canonical site origin for Checkout / Connect return URLs
# NEXT_PUBLIC_APP_URL=http://localhost:3000
